{
  "description": "@gcu/expr evaluation vectors — the carried core (from hopper's rule engine: arithmetic, comparison, boolean, between/contains/matches, is blank/filled, totality) + the GCU additions (geo math, casts, tests, bracket escape, case-insensitive idents). verb: omitted/relevant = evalBool, calculate = evaluate (null = blank), constrain = constraintValid(target).",
  "vectors": [
    { "expr": "fe_pct between 0 and 100", "values": { "fe_pct": 64.2 }, "expected": true },
    { "expr": "fe_pct between 0 and 100", "values": { "fe_pct": 140 }, "expected": false },
    { "expr": "fe_pct > 60", "values": { "fe_pct": 64.2 }, "expected": true },
    { "expr": "fe_pct > 60", "values": { "fe_pct": 46.2 }, "expected": false },
    { "expr": "fe_pct >= 60", "values": { "fe_pct": 60 }, "expected": true },
    { "expr": "resample = \"yes\"", "values": { "resample": "yes" }, "expected": true },
    { "expr": "resample = \"yes\"", "values": { "resample": "no" }, "expected": false },
    { "expr": "resample != \"yes\"", "values": { "resample": "no" }, "expected": true },
    { "expr": "litho contains \"itabirite\"", "values": { "litho": ["itabirite", "canga"] }, "expected": true },
    { "expr": "litho contains \"hematitite\"", "values": { "litho": ["itabirite", "canga"] }, "expected": false },
    { "expr": "site_id is filled", "values": { "site_id": "QF-118" }, "expected": true },
    { "expr": "site_id is blank", "values": {}, "expected": true },
    { "expr": "fe_pct > 60 and lithology = \"itabirite\"", "values": { "fe_pct": 64.2, "lithology": "itabirite" }, "expected": true },
    { "expr": "fe_pct > 60 or lithology = \"canga\"", "values": { "fe_pct": 10, "lithology": "canga" }, "expected": true },
    { "expr": "not (fe_pct > 60)", "values": { "fe_pct": 10 }, "expected": true },

    { "note": "blank evaluates false for a boolean reading", "verb": "relevant", "expr": "resample = \"yes\"", "values": {}, "expected": false },
    { "note": "a constraint passes on an empty answer", "verb": "constrain", "target": "fe_pct", "expr": "fe_pct between 0 and 100", "values": {}, "expectedConstraintValid": true },
    { "note": "a filled answer must satisfy the constraint", "verb": "constrain", "target": "fe_pct", "expr": "fe_pct between 0 and 100", "values": { "fe_pct": 140 }, "expectedConstraintValid": false },

    { "note": "÷0 → blank, never throws (totality)", "verb": "calculate", "expr": "a / b", "values": { "a": 5, "b": 0 }, "expected": null },
    { "note": "precedence (* before +)", "verb": "calculate", "expr": "a + b * 2", "values": { "a": 1, "b": 3 }, "expected": 7 },
    { "note": "parens override precedence", "verb": "calculate", "expr": "(a + b) * 2", "values": { "a": 1, "b": 3 }, "expected": 8 },
    { "note": "subtraction needs surrounding space", "verb": "calculate", "expr": "a - 5", "values": { "a": 12 }, "expected": 7 },

    { "note": "if() picks a branch", "verb": "calculate", "expr": "if(grade > 1, \"ore\", \"waste\")", "values": { "grade": 2.5 }, "expected": "ore" },
    { "note": "round to 2 dp", "verb": "calculate", "expr": "round(x, 2)", "values": { "x": 3.14159 }, "expected": 3.14 },
    { "note": "int truncates", "verb": "calculate", "expr": "int(x)", "values": { "x": 3.9 }, "expected": 3 },
    { "note": "abs", "verb": "calculate", "expr": "abs(x)", "values": { "x": -4.5 }, "expected": 4.5 },

    { "note": "geo: sqrt", "verb": "calculate", "expr": "sqrt(x)", "values": { "x": 9 }, "expected": 3 },
    { "note": "geo: sqrt of negative → blank (totality)", "verb": "calculate", "expr": "sqrt(x)", "values": { "x": -1 }, "expected": null },
    { "note": "geo: pow", "verb": "calculate", "expr": "pow(b, e)", "values": { "b": 2, "e": 10 }, "expected": 1024 },
    { "note": "geo: log of 0 → blank", "verb": "calculate", "expr": "log(x)", "values": { "x": 0 }, "expected": null },
    { "note": "geo: min over args", "verb": "calculate", "expr": "min(a, b, c)", "values": { "a": 5, "b": 2, "c": 9 }, "expected": 2 },
    { "note": "geo: max skips blanks", "verb": "calculate", "expr": "max(a, b)", "values": { "a": 5 }, "expected": 5 },
    { "note": "geo: clamp", "verb": "calculate", "expr": "clamp(x, 0, 10)", "values": { "x": 14 }, "expected": 10 },
    { "note": "bin: lower edge of a width-0.5 bin", "verb": "calculate", "expr": "bin(au, 0.5)", "values": { "au": 1.7 }, "expected": 1.5 },
    { "note": "bin: floors negatives correctly", "verb": "calculate", "expr": "bin(z, 10)", "values": { "z": -3 }, "expected": -10 },
    { "note": "bin: with an origin", "verb": "calculate", "expr": "bin(x, 5, 2)", "values": { "x": 13 }, "expected": 12 },
    { "note": "bin: blank/bad width → blank", "verb": "calculate", "expr": "bin(x, 0)", "values": { "x": 5 }, "expected": null },

    { "note": "cast: ifnum keeps a number", "verb": "calculate", "expr": "ifnum(g, 0)", "values": { "g": 1.5 }, "expected": 1.5 },
    { "note": "cast: ifnum substitutes for a blank (explicit opt-out of blank-propagation)", "verb": "calculate", "expr": "ifnum(g, 0)", "values": {}, "expected": 0 },
    { "note": "cast: coalesce takes the first non-blank", "verb": "calculate", "expr": "coalesce(a, b, c)", "values": { "b": 7 }, "expected": 7 },
    { "note": "blank propagates by default — NO silent NaN→0", "verb": "calculate", "expr": "g + 1", "values": {}, "expected": null },

    { "note": "test: isnum", "expr": "isnum(g)", "values": { "g": 2.1 }, "expected": true },
    { "note": "test: isnan (present but not numeric)", "expr": "isnan(g)", "values": { "g": "ND" }, "expected": true },
    { "note": "test: isnan false for a real number", "expr": "isnan(g)", "values": { "g": 3 }, "expected": false },
    { "note": "test: isblank()", "expr": "isblank(g)", "values": {}, "expected": true },

    { "note": "LEGACY bracket escape still parses (shipped lenses)", "verb": "calculate", "expr": "[\"Cu (ppm)\"] * 2", "values": { "Cu (ppm)": 50 }, "expected": 100 },
    { "note": "v0.2: hyphenated column takes the backtick escape (OK-Indic from a real block model)", "expr": "`OK-Indic` = 1", "values": { "OK-Indic": 1 }, "expected": true },
    { "note": "keywords are case-insensitive", "expr": "a > 1 AND b < 5", "values": { "a": 2, "b": 3 }, "expected": true },
    { "note": "matches a regex", "expr": "code matches \"^DDH\"", "values": { "code": "DDH0042" }, "expected": true },

    { "note": "v0.2 lexical: unspaced hyphen is SUBTRACTION now", "verb": "calculate", "expr": "a-b", "values": { "a": 5, "b": 2 }, "expected": 3 },
    { "note": "v0.2 lexical: ident-minus-number", "expr": "AU-5 > 0", "values": { "AU": 10 }, "expected": true },
    { "note": "v0.2 backticks: spaces in a column name", "expr": "`Assay Au ppm` > 1", "values": { "Assay Au ppm": 2 }, "expected": true },
    { "note": "v0.2 backticks: escaped backtick in a name", "verb": "calculate", "expr": "`we\\`ird` + 1", "values": { "we`ird": 1 }, "expected": 2 },
    { "note": "v0.2 backticks: reserved word as a column", "verb": "calculate", "expr": "`in` * 2", "values": { "in": 3 }, "expected": 6 },

    { "note": "v0.2 power: caret", "verb": "calculate", "expr": "2^10", "values": {}, "expected": 1024 },
    { "note": "v0.2 power: python spelling", "verb": "calculate", "expr": "2**10", "values": {}, "expected": 1024 },
    { "note": "v0.2 power: right-assoc (2^(3^2))", "verb": "calculate", "expr": "2^3^2", "values": {}, "expected": 512 },
    { "note": "v0.2 power: -2^2 = -(2^2), python/pandas convention", "verb": "calculate", "expr": "-2^2", "values": {}, "expected": -4 },
    { "note": "v0.2 power: negative exponent", "verb": "calculate", "expr": "2^-3", "values": {}, "expected": 0.125 },
    { "note": "v0.2 power: binds tighter than *", "verb": "calculate", "expr": "3*2^2", "values": {}, "expected": 12 },
    { "note": "v0.2 power: blank propagates", "verb": "calculate", "expr": "missing^2", "values": {}, "expected": null },

    { "note": "v0.2 blank literal: sentinel scrub via if", "verb": "calculate", "expr": "if(a = -99, blank, a)", "values": { "a": -99 }, "expected": null },
    { "note": "v0.2 blank literal: pass-through side", "verb": "calculate", "expr": "if(a = -99, blank, a)", "values": { "a": 3.5 }, "expected": 3.5 },
    { "note": "v0.2 nullif: sentinel hit", "verb": "calculate", "expr": "nullif(a, -99)", "values": { "a": -99 }, "expected": null },
    { "note": "v0.2 nullif: value kept", "verb": "calculate", "expr": "nullif(a, -99)", "values": { "a": 4 }, "expected": 4 },
    { "note": "v0.2 nullif: composes with coalesce", "verb": "calculate", "expr": "coalesce(nullif(a, -99), 0.5)", "values": { "a": -99 }, "expected": 0.5 },

    { "note": "v0.2 log10", "verb": "calculate", "expr": "log10(100)", "values": {}, "expected": 2 },
    { "note": "v0.2 log10: nonpositive → blank", "verb": "calculate", "expr": "log10(0)", "values": {}, "expected": null },
    { "note": "v0.2 floor on negatives (int truncates — floor(-2.5) = -3)", "verb": "calculate", "expr": "floor(-2.5)", "values": {}, "expected": -3 },
    { "note": "v0.2 ceil on negatives", "verb": "calculate", "expr": "ceil(-2.5)", "values": {}, "expected": -2 },
    { "note": "v0.2 mod: positive", "verb": "calculate", "expr": "mod(7, 3)", "values": {}, "expected": 1 },
    { "note": "v0.2 mod is FLOORED (Excel): mod(-7,3) = 2", "verb": "calculate", "expr": "mod(-7, 3)", "values": {}, "expected": 2 },
    { "note": "v0.2 mod by zero → blank", "verb": "calculate", "expr": "mod(5, 0)", "values": {}, "expected": null },

    { "note": "v0.2 strings: upper", "verb": "calculate", "expr": "upper(id)", "values": { "id": "ddh-023" }, "expected": "DDH-023" },
    { "note": "v0.2 strings: lower of a number stringifies", "verb": "calculate", "expr": "lower(x)", "values": { "x": 5 }, "expected": "5" },
    { "note": "v0.2 strings: trim", "verb": "calculate", "expr": "trim(id)", "values": { "id": "  DDH-1 " }, "expected": "DDH-1" },
    { "note": "v0.2 strings: len", "verb": "calculate", "expr": "len(id)", "values": { "id": "DDH-023" }, "expected": 7 },
    { "note": "v0.2 strings: len(blank) is blank, not 0", "verb": "calculate", "expr": "len(missing)", "values": {}, "expected": null },
    { "note": "v0.2 strings: left", "verb": "calculate", "expr": "left(id, 3)", "values": { "id": "DDH-023" }, "expected": "DDH" },
    { "note": "v0.2 strings: right", "verb": "calculate", "expr": "right(id, 3)", "values": { "id": "DDH-023" }, "expected": "023" },
    { "note": "v0.2 strings: substr is 1-based (SQL/Excel MID)", "verb": "calculate", "expr": "substr(id, 5, 3)", "values": { "id": "DDH-023" }, "expected": "023" },
    { "note": "v0.2 strings: substr to end", "verb": "calculate", "expr": "substr(id, 5)", "values": { "id": "DDH-023" }, "expected": "023" },
    { "note": "v0.2 strings: replace-all, literal", "verb": "calculate", "expr": "replace(id, \"-\", \"_\")", "values": { "id": "a-b-c" }, "expected": "a_b_c" },
    { "note": "v0.2 strings: replace with empty deletes", "verb": "calculate", "expr": "replace(id, \"-\", \"\")", "values": { "id": "a-b-c" }, "expected": "abc" },
    { "note": "v0.2 strings: concat skips blanks (join-key building)", "verb": "calculate", "expr": "concat(\"DDH-\", n)", "values": { "n": 23 }, "expected": "DDH-23" },
    { "note": "v0.2 strings: concat of blank + value", "verb": "calculate", "expr": "concat(a, b)", "values": { "b": "x" }, "expected": "x" },
    { "note": "v0.2 strings: blank propagates through upper", "verb": "calculate", "expr": "upper(missing)", "values": {}, "expected": null },
    { "note": "v0.2 strings: join-key cleanup end-to-end", "verb": "calculate", "expr": "upper(trim(id))", "values": { "id": " ddh-9 " }, "expected": "DDH-9" },

    { "note": "truth table: not(blank cmp) is TRUE (set-complement, not SQL 3VL)", "expr": "not (AU > 5)", "values": {}, "expected": true },
    { "note": "truth table: the dual spelling differs on blanks (documented)", "expr": "AU <= 5", "values": {}, "expected": false },
    { "note": "truth table: blank and true → false-y", "expr": "(AU > 5) and true", "values": {}, "expected": false },
    { "note": "truth table: blank or true → true", "expr": "(AU > 5) or true", "values": {}, "expected": true },
    { "note": "truth table: blank or false → false-y", "expr": "(AU > 5) or false", "values": {}, "expected": false },
    { "note": "truth table: not not blank-cmp = not true = false", "expr": "not (not (AU > 5))", "values": {}, "expected": false },
    { "note": "truth table: x = blank matches blank rows (the friendly non-SQL choice)", "expr": "AU = blank", "values": {}, "expected": true },
    { "note": "truth table: filled row fails = blank", "expr": "AU = blank", "values": { "AU": 3 }, "expected": false },

    { "note": "v0.2 comments: # to end of line (pandas-style)", "verb": "calculate", "expr": "AU * 2  # double it", "values": { "AU": 3 }, "expected": 6 },
    { "note": "v0.2 comments: multiline expression with per-line comments", "expr": "AU > 0.5  # cutoff\n  and LITO = \"OX\"  # oxide only", "values": { "AU": 1, "LITO": "OX" }, "expected": true },
    { "note": "v0.2 comments: # inside a string is TEXT, not a comment", "verb": "calculate", "expr": "concat(\"a#b\", \"!\")", "values": {}, "expected": "a#b!" }
  ]
}
