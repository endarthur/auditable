{
  "name": "@gcu/soft",
  "version": "0.2.0",
  "description": "Soft — an English-keyword programming language with a tree-walking evaluator. Pure JS interpreter, locale-aware keywords (en, pt-BR bundled). Semantics map closer to JS than Python.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./air": {
      "types": "./src/air.d.ts",
      "default": "./src/air.js"
    },
    "./tokenize": "./src/tokenize.js",
    "./parse": "./src/parse.js",
    "./eval": "./src/eval.js",
    "./runtime": "./src/runtime.js",
    "./tag": "./src/tag.js",
    "./cell": "./src/cell.js",
    "./highlight": "./src/highlight.js",
    "./register": "./src/register.js",
    "./bundled": "./index.js",
    "./package.json": "./package.json"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "locales",
    "index.js",
    "LICENSE",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node build.js"
  },
  "peerDependencies": {
    "@gcu/air": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@gcu/air": {
      "optional": true
    }
  },
  "keywords": ["language", "interpreter", "english-keywords", "dsl", "soft", "locale", "auditable", "gcu"],
  "license": "MIT",
  "author": "Arthur Endlein Correia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endarthur/auditable.git",
    "directory": "ext/soft"
  },
  "homepage": "https://github.com/endarthur/auditable/tree/main/ext/soft",
  "bugs": {
    "url": "https://github.com/endarthur/auditable/issues"
  }
}
