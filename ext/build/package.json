{
  "name": "@gcu/build",
  "version": "0.1.0",
  "description": "Owned AST bundler for the GCU ecosystem. Concat + scope-isolate (rename-on-collision), never transform. Pure browser-native core + thin I/O adapters. Replaces the hand-written ext/*/build.js regex-concat scripts.",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "gcu-build": "./cli.js"
  },
  "exports": {
    ".": "./src/main.js",
    "./core": "./src/core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cli.js",
    "LICENSE",
    "SPEC.md"
  ],
  "keywords": ["bundler", "esm", "ast", "concat", "scope", "gcu", "auditable", "owned"],
  "license": "MIT",
  "author": "Arthur Endlein Correia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentropic/auditable.git",
    "directory": "ext/build"
  },
  "homepage": "https://github.com/gentropic/auditable/tree/main/ext/build"
}
