    "./adapters/headless": "./src/adapters/headless.js",
    "./bundled": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.js",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node --test ../../test/geas.test.mjs"
  },
  "keywords": ["shell", "posix", "sh", "geas", "vfs", "gcu", "coreutils"],
