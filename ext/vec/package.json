{
  "name": "@gcu/vec",
  "version": "0.1.0",
  "description": "TypedArray-based numerical library for JS. Lightweight NumPy alternative — ndarray with NumPy-style broadcasting, element-wise ops, reductions, small dense linear algebra (solve, cholesky, lstsq, eigSym). Pure JS, no wasm, no dependencies.",
  "type": "module",
  "main": "index.js",
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./adder": "./adder.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "adder.js",
    "types.d.ts",
    "src/",
    "SPEC.md",
    "README.md"
  ],
  "peerDependencies": {
    "@gcu/adder": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@gcu/adder": {
      "optional": true
    }
  },
  "keywords": ["ndarray", "numpy", "linear-algebra", "matrix", "broadcasting", "numerical", "typedarray", "float64", "auditable", "gcu"],
  "license": "MIT",
  "author": "Arthur Endlein Correia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endarthur/auditable.git",
    "directory": "ext/vec"
  },
  "homepage": "https://github.com/endarthur/auditable/tree/main/ext/vec",
  "bugs": {
    "url": "https://github.com/endarthur/auditable/issues"
  }
}
