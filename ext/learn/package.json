    "./preprocessing": "./index.js",
    "./compositional": "./index.js",
    "./impute": "./index.js",
    "./model_selection": "./index.js",
    "./metrics": "./index.js",
    "./pipeline": "./index.js",
    "./serialize": "./index.js",
    "./adder": "./adder.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "adder.js",
    "src/",
    "README.md"
  ],
  "peerDependencies": {
    "@gcu/mimic-io": "^0.1.0",
    "@gcu/natra": "^0.2.0",
    "@gcu/line": "^0.3.0",
    "@gcu/alpack": "^0.1.0",
