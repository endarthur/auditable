! ══════════════════════════════════════════════════════════════════════
! ALAS / ALPACK — dense linear algebra for atra
!
! ALAS  (Auditable Linear Algebra Subprograms) — vector/matrix primitives
! ALPACK (Auditable Linear Algebra PACKage)    — factorizations & solvers
!
! all matrices are row-major, flat in linear memory.
! 2D access: a[i, n, j] where n = number of columns (stride).
! caller provides all buffers. info[0] = 0 on success.
! ══════════════════════════════════════════════════════════════════════

! ── ALAS Level 1: vector-vector ─────────────────────────────────────

! x := alpha * x
subroutine alas.dscal(x: array f64; n: i32; alpha: f64)
var
  i, n2: i32
  va, vx: f64x2
begin
  va := f64x2.splat(alpha)
  n2 := n / 2
  for i := 0, n2
    vx := v128.load(x, i)
    vx := va * vx
    call v128.store(x, i, vx)
  end for
  if (n2 * 2 < n) then
    i := n2 * 2
    x[i] := alpha * x[i]
  end if
end

! y := x  (copy x into y)
subroutine alas.dcopy(x: array f64; y: array f64; n: i32)
var
  i, n2: i32
  vx: f64x2
begin
  n2 := n / 2
  for i := 0, n2
    vx := v128.load(x, i)
    call v128.store(y, i, vx)
  end for
  if (n2 * 2 < n) then
    i := n2 * 2
    y[i] := x[i]
  end if
end

! y := alpha * x + y
subroutine alas.daxpy(x: array f64; y: array f64; n: i32; alpha: f64)
var
  i, n2: i32
  va, vx, vy: f64x2
begin
  ! scalar version (for reference):
  !   for i := 0, n
  !     y[i] := alpha * x[i] + y[i]
  !   end for
  va := f64x2.splat(alpha)
  n2 := n / 2
  for i := 0, n2
    vx := v128.load(x, i)
    vy := v128.load(y, i)
    vy := f64x2.relaxed_madd(va, vx, vy)
    call v128.store(y, i, vy)
  end for
  ! scalar tail for odd element
  if (n2 * 2 < n) then
    i := n2 * 2
    y[i] := alpha * x[i] + y[i]
  end if
end

! returns x^T y  (dot product)
function alas.ddot(x: array f64; y: array f64; n: i32): f64
var
  i, n2: i32
  vx, vy, vs: f64x2
begin
  ! scalar version:
  !   alas.ddot := 0.0
  !   for i := 0, n
  !     alas.ddot := alas.ddot + x[i] * y[i]
  !   end for
  ! NOTE: this loop uses separate mul + add rather than f64x2.relaxed_madd.
  ! The reduction has a single accumulator vs that's recurrence-dependent
  ! (vs[k] = vs[k-1] + ...); FMA serializes this dependency chain at FMA
  ! latency, while separate mul+add lets the CPU overlap multiplication
  ! with the previous iteration's add. Empirically ~30% faster than FMA
  ! at 10K-100K on AMD Ryzen AI 9 HX 370. dgemm/dger/dgemv use FMA because
  ! their inner loops have m×n parallel accumulators (no serialization).
  vs := f64x2.splat(0.0)
  n2 := n / 2
  for i := 0, n2
    vx := v128.load(x, i)
    vy := v128.load(y, i)
    vs := vs + vx * vy
  end for
  alas.ddot := f64x2.extract_lane(vs, 0) + f64x2.extract_lane(vs, 1)
  ! scalar tail
  if (n2 * 2 < n) then
    i := n2 * 2
    alas.ddot := alas.ddot + x[i] * y[i]
  end if
end

! returns ||x||_2  (Euclidean norm)
function alas.dnrm2(x: array f64; n: i32): f64
var
  i, n2: i32
  vx, vs: f64x2
begin
  ! Same single-accumulator caveat as ddot — see note there.
  vs := f64x2.splat(0.0)
  n2 := n / 2
  for i := 0, n2
    vx := v128.load(x, i)
    vs := vs + vx * vx
  end for
  alas.dnrm2 := f64x2.extract_lane(vs, 0) + f64x2.extract_lane(vs, 1)
  if (n2 * 2 < n) then
    i := n2 * 2
    alas.dnrm2 := alas.dnrm2 + x[i] * x[i]
  end if
  alas.dnrm2 := sqrt(alas.dnrm2)
end

! swap x and y
subroutine alas.dswap(x: array f64; y: array f64; n: i32)
var
  i, n2: i32
  t: f64
  vx, vy: f64x2
begin
  n2 := n / 2
  for i := 0, n2
    vx := v128.load(x, i)
    vy := v128.load(y, i)
    call v128.store(x, i, vy)
    call v128.store(y, i, vx)
  end for
  if (n2 * 2 < n) then
    i := n2 * 2
    t := x[i]
    x[i] := y[i]
    y[i] := t
  end if
end

! returns sum of |x_i|
function alas.dasum(x: array f64; n: i32): f64
var
  i, n2: i32
  vx, vs: f64x2
begin
  vs := f64x2.splat(0.0)
  n2 := n / 2
  for i := 0, n2
    vx := v128.load(x, i)
    vs := vs + f64x2.abs(vx)
  end for
  alas.dasum := f64x2.extract_lane(vs, 0) + f64x2.extract_lane(vs, 1)
  if (n2 * 2 < n) then
    i := n2 * 2
    alas.dasum := alas.dasum + abs(x[i])
  end if
end

! apply Givens rotation: [x; y] := [c s; -s c] * [x; y]
subroutine alas.drot(x: array f64; y: array f64; n: i32; c, s: f64)
var
  i, n2: i32
  t: f64
  vc, vs, vx, vy, vt, vy_new: f64x2
begin
  vc := f64x2.splat(c)
  vs := f64x2.splat(s)
  n2 := n / 2
  for i := 0, n2
    vx := v128.load(x, i)
    vy := v128.load(y, i)
    vt := vc * vx + vs * vy
    vy_new := vc * vy - vs * vx
    call v128.store(y, i, vy_new)
    call v128.store(x, i, vt)
  end for
  if (n2 * 2 < n) then
    i := n2 * 2
    t := c * x[i] + s * y[i]
    y[i] := c * y[i] - s * x[i]
    x[i] := t
  end if
end

! generate Givens rotation: given (a, b), compute (c, s, r)
! such that [c s; -s c] * [a; b] = [r; 0]
! writes c to cs[0], s to cs[1]; returns r
function alas.drotg(a, b: f64; cs: array f64): f64
var r, z: f64
begin
  r := sqrt(a * a + b * b)
  if (r == 0.0) then
    cs[0] := 1.0
    cs[1] := 0.0
    alas.drotg := 0.0
  else
    cs[0] := a / r
    cs[1] := b / r
    alas.drotg := r
  end if
end

! returns index of element with max absolute value
function alas.idamax(x: array f64; n: i32): i32
var i: i32; mx: f64; v: f64
begin
  alas.idamax := 0
  mx := abs(x[0])
  for i := 1, n
    v := abs(x[i])
    if (v > mx) then
      mx := v
      alas.idamax := i
    end if
  end for
end

! ── ALAS Level 2: matrix-vector ─────────────────────────────────────

! y := alpha * A * x + beta * y   (general matrix-vector multiply)
! A is m x n, x has n elements, y has m elements
subroutine alas.dgemv(
  a: array f64; x: array f64; y: array f64;
  m, n: i32; alpha, beta: f64
)
var
  i, j, n2, a_row, joff: i32
  s: f64
  vs, va, vx: f64x2
begin
  ! Single-accumulator reduction per row → mul+add not FMA (same rationale
  ! as ddot — FMA serializes the in-row recurrence at FMA latency).
  n2 := n / 2
  for i := 0, m
    vs := f64x2.splat(0.0)
    a_row := i * n * 8
    for j := 0, n2
      joff := j * 16
      va := v128.load_at(a, a_row + joff)
      vx := v128.load(x, j)
      vs := vs + va * vx
    end for
    s := f64x2.extract_lane(vs, 0) + f64x2.extract_lane(vs, 1)
    if (n2 * 2 < n) then
      j := n2 * 2
      s := s + a[i, n, j] * x[j]
    end if
    y[i] := alpha * s + beta * y[i]
  end for
end

! solve L*x = b or L^T*x = b  (triangular solve)
! uplo: 0 = lower, 1 = upper
! trans: 0 = no transpose, 1 = transpose
! x is overwritten with the solution (input is b, output is x)
subroutine alas.dtrsv(
  a: array f64; x: array f64;
  n, uplo, trans: i32
)
var
  i, j, j2, a_row, joff: i32
  s: f64
  acc, va, vx: f64x2
begin
  if (uplo == 0 and trans == 0) then
    ! lower, no transpose: forward substitution. Inner reads stride-1 → SIMD.
    for i := 0, n
      s := x[i]
      j2 := i / 2
      acc := f64x2.splat(0.0)
      a_row := i * n * 8
      for j := 0, j2
        joff := j * 16
        va := v128.load_at(a, a_row + joff)
        vx := v128.load(x, j)
        acc := acc + va * vx
      end for
      s := s - f64x2.extract_lane(acc, 0) - f64x2.extract_lane(acc, 1)
      if (j2 * 2 < i) then
        j := j2 * 2
        s := s - a[i, n, j] * x[j]
      end if
      x[i] := s / a[i, n, i]
    end for
  else if (uplo == 0 and trans == 1) then
    ! lower, transpose (= upper): back sub. Reads a[j,i] stride-n → scalar.
    for i := n - 1, -1, -1
      s := x[i]
      for j := i + 1, n
        s := s - a[j, n, i] * x[j]
      end for
      x[i] := s / a[i, n, i]
    end for
  else if (uplo == 1 and trans == 0) then
    ! upper, no transpose: back substitution. Inner reads stride-1 → SIMD.
    for i := n - 1, -1, -1
      s := x[i]
      j2 := (n - i - 1) / 2
      acc := f64x2.splat(0.0)
      a_row := (i * n + i + 1) * 8
      for j := 0, j2
        joff := j * 16
        va := v128.load_at(a, a_row + joff)
        vx := v128.load_at(x, (i + 1) * 8 + joff)
        acc := acc + va * vx
      end for
      s := s - f64x2.extract_lane(acc, 0) - f64x2.extract_lane(acc, 1)
      if (j2 * 2 < n - i - 1) then
        j := i + 1 + j2 * 2
        s := s - a[i, n, j] * x[j]
      end if
      x[i] := s / a[i, n, i]
    end for
  else
    ! upper, transpose (= lower): forward sub. Reads a[j,i] stride-n → scalar.
    for i := 0, n
      s := x[i]
      for j := 0, i
        s := s - a[j, n, i] * x[j]
      end for
      x[i] := s / a[i, n, i]
    end for
  end if
end

! A := A + alpha * x * y^T  (rank-1 update)
! A is m x n, x has m elements, y has n elements
subroutine alas.dger(
  a: array f64; x: array f64; y: array f64;
  m, n: i32; alpha: f64
)
var
  i, j, n2, a_row, joff: i32
  t: f64
  tv, vy, va: f64x2
begin
  n2 := n / 2
  for i := 0, m
    t := alpha * x[i]
    tv := f64x2.splat(t)
    a_row := i * n * 8
    for j := 0, n2
      joff := j * 16
      vy := v128.load(y, j)
      va := v128.load_at(a, a_row + joff)
      va := f64x2.relaxed_madd(tv, vy, va)
      call v128.store_at(a, a_row + joff, va)
    end for
    if (n2 * 2 < n) then
      j := n2 * 2
      a[i, n, j] := a[i, n, j] + t * y[j]
    end if
  end for
end

! y := alpha * A * x + beta * y  (symmetric matrix-vector multiply)
! A is n x n symmetric, only lower triangle is read
subroutine alas.dsymv(
  a: array f64; x: array f64; y: array f64;
  n: i32; alpha, beta: f64
)
var
  i, j, j2, a_row, joff: i32
  s, t: f64
  vs, va, vat, vx, vy, vxi, valpha: f64x2
begin
  ! scale y by beta
  for i := 0, n
    y[i] := beta * y[i]
  end for
  ! accumulate: diagonal + off-diagonal (symmetric)
  ! Each j-iteration reads a[i,j], updates s (reduction) AND y[j] (scatter).
  ! Both use the same scaled value alpha*a[i,j]. SIMD over j.
  valpha := f64x2.splat(alpha)
  for i := 0, n
    vs := f64x2.splat(0.0)
    vxi := f64x2.splat(x[i])
    a_row := i * n * 8
    j2 := i / 2
    for j := 0, j2
      joff := j * 16
      va := v128.load_at(a, a_row + joff)
      vat := valpha * va                      ! alpha * a[i, j..j+1]
      vx := v128.load(x, j)
      vs := vs + vat * vx                     ! s += alpha*a[i,j] * x[j]
      vy := v128.load(y, j)
      vy := vy + vat * vxi                    ! y[j] += alpha*a[i,j] * x[i]
      call v128.store(y, j, vy)
    end for
    s := f64x2.extract_lane(vs, 0) + f64x2.extract_lane(vs, 1)
    if (j2 * 2 < i) then
      j := j2 * 2
      t := alpha * a[i, n, j]
      s := s + t * x[j]
      y[j] := y[j] + t * x[i]
    end if
    y[i] := y[i] + s + alpha * a[i, n, i] * x[i]
  end for
end

! A := A + alpha * x * x^T  (symmetric rank-1 update, lower triangle)
! A is n x n symmetric, only lower triangle is updated
subroutine alas.dsyr(
  a: array f64; x: array f64;
  n: i32; alpha: f64
)
var
  i, j, ip1, j2, a_row, joff: i32
  t: f64
  tv, vx, va: f64x2
begin
  for i := 0, n
    t := alpha * x[i]
    tv := f64x2.splat(t)
    a_row := i * n * 8
    ip1 := i + 1
    j2 := ip1 / 2
    for j := 0, j2
      joff := j * 16
      vx := v128.load(x, j)
      va := v128.load_at(a, a_row + joff)
      va := f64x2.relaxed_madd(tv, vx, va)
      call v128.store_at(a, a_row + joff, va)
    end for
    if (j2 * 2 < ip1) then
      j := j2 * 2
      a[i, n, j] := a[i, n, j] + t * x[j]
    end if
  end for
end

! A := A + alpha * (x * y^T + y * x^T)  (symmetric rank-2 update, lower triangle)
! A is n x n symmetric, only lower triangle is updated
subroutine alas.dsyr2(
  a: array f64; x: array f64; y: array f64;
  n: i32; alpha: f64
)
var
  i, j, ip1, j2, a_row, joff: i32
  tx, ty: f64
  tvx, tvy, vx, vy, va: f64x2
begin
  for i := 0, n
    tx := alpha * x[i]
    ty := alpha * y[i]
    tvx := f64x2.splat(tx)
    tvy := f64x2.splat(ty)
    a_row := i * n * 8
    ip1 := i + 1
    j2 := ip1 / 2
    for j := 0, j2
      joff := j * 16
      vx := v128.load(x, j)
      vy := v128.load(y, j)
      va := v128.load_at(a, a_row + joff)
      ! a[i,j] += tx * y[j] + ty * x[j]  via two FMAs
      va := f64x2.relaxed_madd(tvx, vy, va)
      va := f64x2.relaxed_madd(tvy, vx, va)
      call v128.store_at(a, a_row + joff, va)
    end for
    if (j2 * 2 < ip1) then
      j := j2 * 2
      a[i, n, j] := a[i, n, j] + tx * y[j] + ty * x[j]
    end if
  end for
end

! x := A * x  or  x := A^T * x  (triangular matrix-vector multiply)
! uplo: 0 = lower, 1 = upper
! trans: 0 = no transpose, 1 = transpose
! diag: 0 = non-unit, 1 = unit diagonal
subroutine alas.dtrmv(
  a: array f64; x: array f64;
  n, uplo, trans, diag: i32
)
var i, j: i32; s: f64
begin
  if (uplo == 1 and trans == 0) then
    ! upper, no transpose: forward
    for i := 0, n
      s := 0.0
      if (diag == 1) then
        s := x[i]
      else
        s := a[i, n, i] * x[i]
      end if
      for j := i + 1, n
        s := s + a[i, n, j] * x[j]
      end for
      x[i] := s
    end for
  else if (uplo == 0 and trans == 0) then
    ! lower, no transpose: backward
    for i := n - 1, -1, -1
      s := 0.0
      for j := 0, i
        s := s + a[i, n, j] * x[j]
      end for
      if (diag == 1) then
        s := s + x[i]
      else
        s := s + a[i, n, i] * x[i]
      end if
      x[i] := s
    end for
  else if (uplo == 1 and trans == 1) then
    ! upper, transpose (= lower): backward
    for i := n - 1, -1, -1
      s := 0.0
      for j := 0, i
        s := s + a[j, n, i] * x[j]
      end for
      if (diag == 1) then
        s := s + x[i]
      else
        s := s + a[i, n, i] * x[i]
      end if
      x[i] := s
    end for
  else
    ! lower, transpose (= upper): forward
    for i := 0, n
      s := 0.0
      if (diag == 1) then
        s := x[i]
      else
        s := a[i, n, i] * x[i]
      end if
      for j := i + 1, n
        s := s + a[j, n, i] * x[j]
      end for
      x[i] := s
    end for
  end if
end

! ── ALAS Level 3: matrix-matrix ─────────────────────────────────────

! C := alpha * A * B + beta * C  (general matrix-matrix multiply)
! A is m x k, B is k x n, C is m x n
!
! Uses (i, p, j) loop order so the inner loop becomes a daxpy-style update
! `c[i, j] += t * b[p, j]`. Vectorized with f64x2 + relaxed_madd over the
! j axis: each iteration computes 2 elements with a single fused-multiply-
! add. Byte-offset SIMD addressing (v128.load_at) handles odd column count
! n cleanly — no per-shape branching.
!
! beta is handled in a prologue (scale C, or zero it) so the inner loop is
! a pure accumulation.
!
! Note: tried naive cache blocking on (jj, pp) with 64-element blocks —
! no measurable speedup at 500×500 and a slight regression in some runs.
! Real cache-friendly dgemm requires packing A/B into block-shaped arrays
! before the inner kernel, plus three-level blocking sized for L1/L2/L3.
! That's a substantial separate effort; deferred.
subroutine alas.dgemm(
  a: array f64; b: array f64; c: array f64;
  m, n, k: i32; alpha, beta: f64
)
var
  i, j, p, n2, c_row, b_row, joff: i32
  t: f64
  tv, vb, vc: f64x2
begin
  ! Phase 1: prepare C.
  if (beta == 0.0) then
    for i := 0, m
      for j := 0, n
        c[i, n, j] := 0.0
      end for
    end for
  else if (beta /= 1.0) then
    for i := 0, m
      for j := 0, n
        c[i, n, j] := beta * c[i, n, j]
      end for
    end for
  end if

  ! Phase 2: C += alpha * A * B with SIMD inner loop.
  n2 := n / 2
  for i := 0, m
    c_row := i * n * 8         ! byte offset of row i in C
    for p := 0, k
      t := alpha * a[i, k, p]
      tv := f64x2.splat(t)
      b_row := p * n * 8       ! byte offset of row p in B
      for j := 0, n2
        joff := j * 16
        vb := v128.load_at(b, b_row + joff)
        vc := v128.load_at(c, c_row + joff)
        vc := f64x2.relaxed_madd(tv, vb, vc)
        call v128.store_at(c, c_row + joff, vc)
      end for
      ! scalar tail for odd n
      if (n2 * 2 < n) then
        j := n2 * 2
        c[i, n, j] := c[i, n, j] + t * b[p, n, j]
      end if
    end for
  end for
end

! ── dgemm with (ii, jj) cache blocking + B-column packing ──────────
!
! EXPERIMENTAL — NO MEASURABLE SPEEDUP over plain SIMD dgemm on AMD
! Ryzen AI 9 HX 370 (within 5% across N = 50..500). Kept in source for
! future investigators building on it (e.g. adding a register-blocked
! microkernel to extract instruction-level parallelism).
!
! Why naive blocking doesn't help: the SIMD inner loop already streams
! rows of B sequentially with stride-1 reads, which is exactly what
! the hardware prefetcher predicts. Packing converts stride-n reads
! across the p loop to stride-1 reads through `pack`, but the original
! stride-n was already amortized across many SIMD iterations within a
! single row. The L2/L3 prefetcher handles it.
!
! What WOULD help: a register-blocked microkernel processing e.g. 4×4
! blocks of C with partial sums kept in 8 f64x2 accumulators across
! multiple p iterations. V8 should allocate those to xmm registers and
! avoid the load/store traffic to C between iterations. That's a
! meaningfully different optimization than "block and pack" alone.
!
! Scratch buffer requirement: k × 32 f64 (= 128 KB at k=500). Caller
! (natra) allocates from its scope arena and passes via `pack`.
subroutine alas.dgemm_packed(
  a: array f64; b: array f64; c: array f64;
  m, n, k: i32; alpha, beta: f64;
  pack: array f64
)
var
  i, j, p, jj, kk, ii: i32
  jbound, kbound, ibound, nblock, kblock: i32
  c_row, pack_row, joff, n2: i32
  t: f64
  tv, vb, vc: f64x2
begin
  ! Phase 1: prepare C
  if (beta == 0.0) then
    for i := 0, m
      for j := 0, n
        c[i, n, j] := 0.0
      end for
    end for
  else if (beta /= 1.0) then
    for i := 0, m
      for j := 0, n
        c[i, n, j] := beta * c[i, n, j]
      end for
    end for
  end if

  ! Phase 2: (ii, jj) tile blocking — process a 32×32 tile of C at a time
  ! so the tile stays hot in L1 across the full k contraction. B's panel
  ! [0:k, jj:jj+32] is packed once per (ii, jj) so reads are stride-1.
  for jj := 0, n, 32
    jbound := jj + 32
    if (jbound > n) then
      jbound := n
    end if
    nblock := jbound - jj
    n2 := nblock / 2

    ! Pack B[:, jj:jj+nblock] (full k rows × nblock cols) into pack, row-major.
    ! Buffer size: k * nblock f64. Caller provides pack of size >= k * 32.
    for p := 0, k
      for j := 0, nblock
        pack[p * 32 + j] := b[p, n, jj + j]
      end for
    end for

    for ii := 0, m, 32
      ibound := ii + 32
      if (ibound > m) then
        ibound := m
      end if

      ! Inner kernel: process tile C[ii:ibound, jj:jj+nblock]. Within the
      ! tile, each row i of C is touched k times (once per p). Pack provides
      ! stride-1 reads for B.
      for i := ii, ibound
        c_row := (i * n + jj) * 8
        for p := 0, k
          t := alpha * a[i, k, p]
          tv := f64x2.splat(t)
          pack_row := p * 32 * 8
          for j := 0, n2
            joff := j * 16
            vb := v128.load_at(pack, pack_row + joff)
            vc := v128.load_at(c, c_row + joff)
            vc := f64x2.relaxed_madd(tv, vb, vc)
            call v128.store_at(c, c_row + joff, vc)
          end for
          for j := n2 * 2, nblock
            c[i, n, jj + j] := c[i, n, jj + j] + t * pack[p * 32 + j]
          end for
        end for
      end for
    end for
  end for
end

! ══════════════════════════════════════════════════════════════════════
! ALPACK — factorizations, solvers, eigendecomposition
! ══════════════════════════════════════════════════════════════════════

! ── Cholesky factorization ──────────────────────────────────────────

! A = L * L^T  (in-place, lower triangle overwritten with L)
! info[0] = 0 on success, k > 0 if not positive-definite at column k
!
! Both inner loops are reductions over k in [0, j) with stride-1 reads
! along rows of A. SIMD'd with v128 accumulator + scalar tail. Single-
! accumulator pattern → separate mul+add (no FMA) per ddot rationale.
subroutine alpack.dpotrf(a: array f64; n: i32; info: array i32)
var
  i, j, k, j2, ai_base, aj_base, koff: i32
  s: f64
  acc, va, vj: f64x2
begin
  info[0] := 0
  for j := 0, n
    ! diagonal: s := a[j,j] - sum_{k<j} a[j,k]^2
    s := a[j, n, j]
    j2 := j / 2
    acc := f64x2.splat(0.0)
    aj_base := j * n * 8
    for k := 0, j2
      koff := k * 16
      vj := v128.load_at(a, aj_base + koff)
      acc := acc + vj * vj
    end for
    s := s - f64x2.extract_lane(acc, 0) - f64x2.extract_lane(acc, 1)
    if (j2 * 2 < j) then
      k := j2 * 2
      s := s - a[j, n, k] * a[j, n, k]
    end if

    if (s <= 0.0) then
      info[0] := j + 1
      call return()
    end if
    a[j, n, j] := sqrt(s)

    ! off-diagonal: s := a[i,j] - sum_{k<j} a[i,k] * a[j,k]
    for i := j + 1, n
      s := a[i, n, j]
      acc := f64x2.splat(0.0)
      ai_base := i * n * 8
      for k := 0, j2
        koff := k * 16
        va := v128.load_at(a, ai_base + koff)
        vj := v128.load_at(a, aj_base + koff)
        acc := acc + va * vj
      end for
      s := s - f64x2.extract_lane(acc, 0) - f64x2.extract_lane(acc, 1)
      if (j2 * 2 < j) then
        k := j2 * 2
        s := s - a[i, n, k] * a[j, n, k]
      end if
      a[i, n, j] := s / a[j, n, j]
    end for
  end for
end

! solve A*X = B given Cholesky factor L from dpotrf
! B is overwritten with X.  B is n x nrhs (each column is an RHS)
!
! Forward sub (L y = b) reads l[i,j] stride-1 in j → SIMD'd for nrhs=1.
! Back sub (L^T x = y) reads l[j,i] stride-n in j (column traversal of L)
! — kept scalar; SIMD would require an on-the-fly transpose.
subroutine alpack.dpotrs(
  l: array f64; b: array f64;
  n, nrhs: i32
)
var
  rhs, i, j, j2, l_row, joff: i32
  s: f64
  acc, vl, vb: f64x2
begin
  for rhs := 0, nrhs
    if (nrhs == 1) then
      ! forward substitution (SIMD nrhs=1 path)
      for i := 0, n
        s := b[i]
        j2 := i / 2
        acc := f64x2.splat(0.0)
        l_row := i * n * 8
        for j := 0, j2
          joff := j * 16
          vl := v128.load_at(l, l_row + joff)
          vb := v128.load(b, j)
          acc := acc + vl * vb
        end for
        s := s - f64x2.extract_lane(acc, 0) - f64x2.extract_lane(acc, 1)
        if (j2 * 2 < i) then
          j := j2 * 2
          s := s - l[i, n, j] * b[j]
        end if
        b[i] := s / l[i, n, i]
      end for
      ! back substitution: column-major access on L → scalar
      for i := n - 1, -1, -1
        s := b[i]
        for j := i + 1, n
          s := s - l[j, n, i] * b[j]
        end for
        b[i] := s / l[i, n, i]
      end for
    else
    ! Multi-RHS scalar path
    ! forward substitution: L * y = b
    for i := 0, n
      s := b[i, nrhs, rhs]
      for j := 0, i
        s := s - l[i, n, j] * b[j, nrhs, rhs]
      end for
      b[i, nrhs, rhs] := s / l[i, n, i]
    end for
    ! back substitution: L^T * x = y
    for i := n - 1, -1, -1
      s := b[i, nrhs, rhs]
      for j := i + 1, n
        s := s - l[j, n, i] * b[j, nrhs, rhs]
      end for
      b[i, nrhs, rhs] := s / l[i, n, i]
    end for
    end if
  end for
end

! ── LU factorization with partial pivoting ──────────────────────────

! A = P * L * U  (in-place, L below diagonal with unit diagonal, U on+above)
! ipiv is an n-element i32 array of pivot indices
! info[0] = 0 on success, k > 0 if U(k,k) is zero
subroutine alpack.dgetrf(
  a: array f64; n: i32;
  ipiv: array i32; info: array i32
)
var
  i, j, k, pivot, nrem, nrem2, ai_base, ak_base, joff: i32
  t, inv, m: f64
  mv, vk, vi: f64x2
begin
  info[0] := 0
  for k := 0, n
    ! find pivot in column k from row k..n-1
    pivot := k
    t := abs(a[k, n, k])
    for i := k + 1, n
      if (abs(a[i, n, k]) > t) then
        pivot := i
        t := abs(a[i, n, k])
      end if
    end for
    ipiv[k] := pivot

    ! swap rows k and pivot
    if (pivot /= k) then
      for j := 0, n
        t := a[k, n, j]
        a[k, n, j] := a[pivot, n, j]
        a[pivot, n, j] := t
      end for
    end if

    if (a[k, n, k] == 0.0) then
      info[0] := k + 1
      call return()
    end if

    ! eliminate below diagonal: rank-1 update of the trailing (n-k-1)×(n-k-1)
    ! submatrix using the daxpy/nmadd pattern over the inner j loop.
    inv := 1.0 / a[k, n, k]
    nrem := n - k - 1
    nrem2 := nrem / 2
    ak_base := (k * n + k + 1) * 8
    for i := k + 1, n
      m := a[i, n, k] * inv
      a[i, n, k] := m
      mv := f64x2.splat(m)
      ai_base := (i * n + k + 1) * 8
      for j := 0, nrem2
        joff := j * 16
        vk := v128.load_at(a, ak_base + joff)
        vi := v128.load_at(a, ai_base + joff)
        vi := f64x2.relaxed_nmadd(mv, vk, vi)
        call v128.store_at(a, ai_base + joff, vi)
      end for
      ! scalar tail when nrem is odd
      if (nrem2 * 2 < nrem) then
        j := k + 1 + nrem2 * 2
        a[i, n, j] := a[i, n, j] - m * a[k, n, j]
      end if
    end for
  end for
end

! solve A*X = B given LU factorization from dgetrf
! B is n x nrhs, overwritten with X
!
! For nrhs = 1 (the common case for natra.solve), b is effectively 1D
! and both lu[i,j] and b[j] are stride-1 in j — the inner reduction can
! be SIMD'd via a v128 accumulator. For multi-RHS, b accesses are
! stride-nrhs and the scalar path is used. Same mul+add pattern as ddot
! (single recurrence-dependent accumulator → no FMA).
subroutine alpack.dgetrs(
  lu: array f64; ipiv: array i32;
  b: array f64; n, nrhs: i32
)
var
  rhs, i, j, p, j2, lu_row, joff: i32
  s, t: f64
  acc, vlu, vb: f64x2
begin
  for rhs := 0, nrhs
    ! apply row permutation
    for i := 0, n
      p := ipiv[i]
      if (p /= i) then
        t := b[i, nrhs, rhs]
        b[i, nrhs, rhs] := b[p, nrhs, rhs]
        b[p, nrhs, rhs] := t
      end if
    end for

    if (nrhs == 1) then
      ! SIMD fast path — b stride-1 in j
      ! forward substitution: s := b[i] - sum_{j<i} lu[i,j] * b[j]
      for i := 1, n
        s := b[i]
        j2 := i / 2
        acc := f64x2.splat(0.0)
        lu_row := i * n * 8
        for j := 0, j2
          joff := j * 16
          vlu := v128.load_at(lu, lu_row + joff)
          vb := v128.load(b, j)
          acc := acc + vlu * vb
        end for
        s := s - f64x2.extract_lane(acc, 0) - f64x2.extract_lane(acc, 1)
        if (j2 * 2 < i) then
          j := j2 * 2
          s := s - lu[i, n, j] * b[j]
        end if
        b[i] := s
      end for
      ! back substitution
      for i := n - 1, -1, -1
        s := b[i]
        ! reduce over j in [i+1, n)
        j2 := (n - i - 1) / 2
        acc := f64x2.splat(0.0)
        lu_row := (i * n + i + 1) * 8
        for j := 0, j2
          joff := j * 16
          vlu := v128.load_at(lu, lu_row + joff)
          vb := v128.load_at(b, (i + 1) * 8 + joff)
          acc := acc + vlu * vb
        end for
        s := s - f64x2.extract_lane(acc, 0) - f64x2.extract_lane(acc, 1)
        if (j2 * 2 < n - i - 1) then
          j := i + 1 + j2 * 2
          s := s - lu[i, n, j] * b[j]
        end if
        b[i] := s / lu[i, n, i]
      end for
    else
      ! Multi-RHS: scalar path (b stride-nrhs in j)
      for i := 1, n
        s := b[i, nrhs, rhs]
        for j := 0, i
          s := s - lu[i, n, j] * b[j, nrhs, rhs]
        end for
        b[i, nrhs, rhs] := s
      end for
      for i := n - 1, -1, -1
        s := b[i, nrhs, rhs]
        for j := i + 1, n
          s := s - lu[i, n, j] * b[j, nrhs, rhs]
        end for
        b[i, nrhs, rhs] := s / lu[i, n, i]
      end for
    end if
  end for
end

! solve A*X = B  (convenience: dgetrf + dgetrs)
! A is overwritten with LU, B is overwritten with X
! scratch: i32 array of length n for pivots
subroutine alpack.dgesv(
  a: array f64; b: array f64;
  n, nrhs: i32;
  ipiv: array i32; info: array i32
)
begin
  call alpack.dgetrf(a, n, ipiv, info)
  if (info[0] /= 0) then
    call return()
  end if
  call alpack.dgetrs(a, ipiv, b, n, nrhs)
end

! ── Triangular inverse ──────────────────────────────────────────────

! invert a lower triangular matrix in-place
! info[0] = 0 on success, k > 0 if diagonal element k is zero
subroutine alpack.dtrtri(a: array f64; n: i32; info: array i32)
var i, j, k: i32; s: f64
begin
  info[0] := 0
  for j := 0, n
    if (a[j, n, j] == 0.0) then
      info[0] := j + 1
      call return()
    end if
    a[j, n, j] := 1.0 / a[j, n, j]
    for i := j + 1, n
      s := 0.0
      for k := j, i
        s := s - a[i, n, k] * a[k, n, j]
      end for
      a[i, n, j] := s / a[i, n, i]
    end for
  end for
end

! ── Eigendecomposition: 3x3 analytical ──────────────────────────────

! eigenvalues of a 3x3 symmetric matrix (analytical, Cardano's method)
! a is 3x3 symmetric (9 f64), w receives 3 eigenvalues (sorted descending)
subroutine alpack.dsyev3(a: array f64; w: array f64)
var
  a00, a01, a02, a11, a12, a22: f64
  p1, q, p2, p, b00, b11, b22, det_b, half_det: f64
  phi, r, e1, e2, e3: f64
  m: f64
  pi: f64
begin
  pi := 3.14159265358979323846

  a00 := a[0, 3, 0]
  a01 := a[0, 3, 1]
  a02 := a[0, 3, 2]
  a11 := a[1, 3, 1]
  a12 := a[1, 3, 2]
  a22 := a[2, 3, 2]

  ! trace / 3
  m := (a00 + a11 + a22) / 3.0

  ! sum of squares of off-diagonal elements
  p1 := a01 * a01 + a02 * a02 + a12 * a12

  if (p1 <= 1e-30) then
    ! diagonal matrix — eigenvalues are the diagonal entries, sort descending
    e1 := a00
    e2 := a11
    e3 := a22
    ! sort 3 values descending (bubble sort)
    if (e2 > e1) then
      r := e1
      e1 := e2
      e2 := r
    end if
    if (e3 > e2) then
      r := e2
      e2 := e3
      e3 := r
    end if
    if (e2 > e1) then
      r := e1
      e1 := e2
      e2 := r
    end if
    w[0] := e1
    w[1] := e2
    w[2] := e3
    call return()
  end if

  q := m
  p2 := (a00 - q) * (a00 - q) + (a11 - q) * (a11 - q) + (a22 - q) * (a22 - q) + 2.0 * p1
  p := sqrt(p2 / 6.0)

  ! B = (A - q*I) / p  — only need determinant
  b00 := (a00 - q) / p
  b11 := (a11 - q) / p
  b22 := (a22 - q) / p
  ! det(B) for symmetric 3x3
  det_b := b00 * (b11 * b22 - (a12 / p) * (a12 / p))
         - (a01 / p) * ((a01 / p) * b22 - (a12 / p) * (a02 / p))
         + (a02 / p) * ((a01 / p) * (a12 / p) - b11 * (a02 / p))
  half_det := det_b / 2.0

  ! clamp to [-1, 1] for acos
  if (half_det <= -1.0) then
    phi := pi / 3.0
  else if (half_det >= 1.0) then
    phi := 0.0
  else
    phi := atan2(sqrt(1.0 - half_det * half_det), half_det) / 3.0
  end if

  ! eigenvalues in descending order
  e1 := q + 2.0 * p * cos(phi)
  e3 := q + 2.0 * p * cos(phi + 2.0 * pi / 3.0)
  e2 := 3.0 * q - e1 - e3

  w[0] := e1
  w[1] := e2
  w[2] := e3
end

! ── Eigendecomposition: 3x3 analytical with eigenvectors ─────────────

! eigenvalues + eigenvectors of a 3x3 symmetric matrix
! a is 3x3 symmetric (9 f64), w receives 3 eigenvalues (sorted descending),
! v receives 3x3 eigenvector matrix (columns are eigenvectors, row-major)
! uses Cardano eigenvalues + cross-product null-space for eigenvectors
subroutine alpack.dsyev3v(a: array f64; w: array f64; v: array f64)
var
  a00, a01, a02, a11, a12, a22: f64
  p1, q, p2, p, b00, b11, b22, det_b, half_det: f64
  phi, r, e1, e2, e3: f64
  m: f64
  pi: f64
  ! eigenvector computation
  k, best: i32
  r0x, r0y, r0z, r1x, r1y, r1z, r2x, r2y, r2z: f64
  cx, cy, cz: f64
  n01, n12, n02, nmax, nrm: f64
begin
  pi := 3.14159265358979323846

  a00 := a[0, 3, 0]
  a01 := a[0, 3, 1]
  a02 := a[0, 3, 2]
  a11 := a[1, 3, 1]
  a12 := a[1, 3, 2]
  a22 := a[2, 3, 2]

  ! ── compute eigenvalues (same as dsyev3) ──
  m := (a00 + a11 + a22) / 3.0
  p1 := a01 * a01 + a02 * a02 + a12 * a12

  if (p1 <= 1e-30) then
    ! diagonal matrix
    e1 := a00
    e2 := a11
    e3 := a22
    if (e2 > e1) then
      r := e1
      e1 := e2
      e2 := r
    end if
    if (e3 > e2) then
      r := e2
      e2 := e3
      e3 := r
    end if
    if (e2 > e1) then
      r := e1
      e1 := e2
      e2 := r
    end if
    w[0] := e1
    w[1] := e2
    w[2] := e3
    ! eigenvectors for diagonal: identity (re-ordered to match eigenvalue order)
    ! Find which diagonal entry maps to which eigenvalue
    ! For simplicity with the sorted eigenvalues, compute eigenvectors below
  else
    q := m
    p2 := (a00 - q) * (a00 - q) + (a11 - q) * (a11 - q) + (a22 - q) * (a22 - q) + 2.0 * p1
    p := sqrt(p2 / 6.0)

    b00 := (a00 - q) / p
    b11 := (a11 - q) / p
    b22 := (a22 - q) / p
    det_b := b00 * (b11 * b22 - (a12 / p) * (a12 / p))
           - (a01 / p) * ((a01 / p) * b22 - (a12 / p) * (a02 / p))
           + (a02 / p) * ((a01 / p) * (a12 / p) - b11 * (a02 / p))
    half_det := det_b / 2.0

    if (half_det <= -1.0) then
      phi := pi / 3.0
    else if (half_det >= 1.0) then
      phi := 0.0
    else
      phi := atan2(sqrt(1.0 - half_det * half_det), half_det) / 3.0
    end if

    e1 := q + 2.0 * p * cos(phi)
    e3 := q + 2.0 * p * cos(phi + 2.0 * pi / 3.0)
    e2 := 3.0 * q - e1 - e3

    w[0] := e1
    w[1] := e2
    w[2] := e3
  end if

  ! ── compute eigenvectors via cross-product null-space ──
  ! For each eigenvalue w[k], form B = A - w[k]*I, take cross product
  ! of two rows with largest cross-product norm
  for k := 0, 3
    r0x := a00 - w[k]
    r0y := a01
    r0z := a02
    r1x := a01
    r1y := a11 - w[k]
    r1z := a12
    r2x := a02
    r2y := a12
    r2z := a22 - w[k]

    ! cross products of row pairs
    ! r0 x r1
    cx := r0y * r1z - r0z * r1y
    cy := r0z * r1x - r0x * r1z
    cz := r0x * r1y - r0y * r1x
    n01 := cx * cx + cy * cy + cz * cz

    nmax := n01
    ! store best cross product
    v[0, 3, k] := cx
    v[1, 3, k] := cy
    v[2, 3, k] := cz

    ! r1 x r2
    cx := r1y * r2z - r1z * r2y
    cy := r1z * r2x - r1x * r2z
    cz := r1x * r2y - r1y * r2x
    n12 := cx * cx + cy * cy + cz * cz
    if (n12 > nmax) then
      nmax := n12
      v[0, 3, k] := cx
      v[1, 3, k] := cy
      v[2, 3, k] := cz
    end if

    ! r0 x r2
    cx := r0y * r2z - r0z * r2y
    cy := r0z * r2x - r0x * r2z
    cz := r0x * r2y - r0y * r2x
    n02 := cx * cx + cy * cy + cz * cz
    if (n02 > nmax) then
      nmax := n02
      v[0, 3, k] := cx
      v[1, 3, k] := cy
      v[2, 3, k] := cz
    end if

    ! normalize
    nrm := sqrt(nmax)
    if (nrm > 1e-30) then
      v[0, 3, k] := v[0, 3, k] / nrm
      v[1, 3, k] := v[1, 3, k] / nrm
      v[2, 3, k] := v[2, 3, k] / nrm
    else
      ! degenerate: use canonical basis vector
      v[0, 3, k] := 0.0
      v[1, 3, k] := 0.0
      v[2, 3, k] := 0.0
      v[k, 3, k] := 1.0
    end if
  end for
end

! ── Eigendecomposition: general symmetric (Jacobi) ──────────────────

! eigenvalues of an n x n symmetric matrix via cyclic Jacobi rotations
! a is overwritten with the eigenvector matrix (columns are eigenvectors)
! w receives n eigenvalues (unsorted)
! info[0] = 0 on success, 1 if not converged
subroutine alpack.dsyev(
  a: array f64; w: array f64;
  n: i32; info: array i32
)
var
  i, j, p, q, iter, maxIter: i32
  off, thresh, app, aqq, apq: f64
  tau, t, c, s, tmp: f64
begin
  info[0] := 0
  maxIter := 100

  ! initialize w to diagonal of a
  for i := 0, n
    w[i] := a[i, n, i]
  end for

  for iter := 0, maxIter
    ! compute off-diagonal norm
    off := 0.0
    for p := 0, n
      for q := p + 1, n
        off := off + a[p, n, q] * a[p, n, q]
      end for
    end for
    if (off < 1e-28) then
      call return()
    end if

    thresh := if (iter < 4) then 0.2 * off / f64(n * n) else 0.0

    for p := 0, n
      for q := p + 1, n
        apq := a[p, n, q]
        if (abs(apq) <= thresh) then
          ! skip small elements in early sweeps
        else
          app := w[p]
          aqq := w[q]
          ! Jacobi rotation angle
          tau := (aqq - app) / (2.0 * apq)
          if (tau >= 0.0) then
            t := 1.0 / (tau + sqrt(1.0 + tau * tau))
          else
            t := 0.0 - 1.0 / (0.0 - tau + sqrt(1.0 + tau * tau))
          end if
          c := 1.0 / sqrt(1.0 + t * t)
          s := t * c

          ! update eigenvalues
          w[p] := app - t * apq
          w[q] := aqq + t * apq
          a[p, n, q] := 0.0

          ! rotate rows/columns p and q
          for i := 0, p
            tmp := a[i, n, p]
            a[i, n, p] := c * tmp - s * a[i, n, q]
            a[i, n, q] := s * tmp + c * a[i, n, q]
          end for
          for i := p + 1, q
            tmp := a[p, n, i]
            a[p, n, i] := c * tmp - s * a[i, n, q]
            a[i, n, q] := s * tmp + c * a[i, n, q]
          end for
          for i := q + 1, n
            tmp := a[p, n, i]
            a[p, n, i] := c * tmp - s * a[q, n, i]
            a[q, n, i] := s * tmp + c * a[q, n, i]
          end for
        end if
      end for
    end for
  end for
  info[0] := 1
end

! ── Eigendecomposition: general symmetric (Jacobi) with eigenvectors ──

! eigenvalues + eigenvectors of an n x n symmetric matrix via cyclic Jacobi
! a is overwritten (destroyed). w receives n eigenvalues (unsorted).
! v receives n x n eigenvector matrix (columns are eigenvectors, row-major).
! info[0] = 0 on success, 1 if not converged
subroutine alpack.dsyevv(
  a: array f64; w: array f64; v: array f64;
  n: i32; info: array i32
)
var
  i, j, p, q, iter, maxIter: i32
  off, thresh, app, aqq, apq: f64
  tau, t, c, s, tmp: f64
begin
  info[0] := 0
  maxIter := 100

  ! initialize V = I
  for i := 0, n
    for j := 0, n
      if (i == j) then
        v[i, n, j] := 1.0
      else
        v[i, n, j] := 0.0
      end if
    end for
  end for

  ! initialize w to diagonal of a
  for i := 0, n
    w[i] := a[i, n, i]
  end for

  for iter := 0, maxIter
    ! compute off-diagonal norm
    off := 0.0
    for p := 0, n
      for q := p + 1, n
        off := off + a[p, n, q] * a[p, n, q]
      end for
    end for
    if (off < 1e-28) then
      call return()
    end if

    thresh := if (iter < 4) then 0.2 * off / f64(n * n) else 0.0

    for p := 0, n
      for q := p + 1, n
        apq := a[p, n, q]
        if (abs(apq) <= thresh) then
          ! skip small elements in early sweeps
        else
          app := w[p]
          aqq := w[q]
          tau := (aqq - app) / (2.0 * apq)
          if (tau >= 0.0) then
            t := 1.0 / (tau + sqrt(1.0 + tau * tau))
          else
            t := 0.0 - 1.0 / (0.0 - tau + sqrt(1.0 + tau * tau))
          end if
          c := 1.0 / sqrt(1.0 + t * t)
          s := t * c

          w[p] := app - t * apq
          w[q] := aqq + t * apq
          a[p, n, q] := 0.0

          ! rotate rows/columns p and q
          for i := 0, p
            tmp := a[i, n, p]
            a[i, n, p] := c * tmp - s * a[i, n, q]
            a[i, n, q] := s * tmp + c * a[i, n, q]
          end for
          for i := p + 1, q
            tmp := a[p, n, i]
            a[p, n, i] := c * tmp - s * a[i, n, q]
            a[i, n, q] := s * tmp + c * a[i, n, q]
          end for
          for i := q + 1, n
            tmp := a[p, n, i]
            a[p, n, i] := c * tmp - s * a[q, n, i]
            a[q, n, i] := s * tmp + c * a[q, n, i]
          end for

          ! accumulate into eigenvector matrix V
          for i := 0, n
            tmp := v[i, n, p]
            v[i, n, p] := c * tmp - s * v[i, n, q]
            v[i, n, q] := s * tmp + c * v[i, n, q]
          end for
        end if
      end for
    end for
  end for
  info[0] := 1
end
! ══════════════════════════════════════════════════════════════════════
! f32 (single-precision) variants — s-prefixed BLAS naming
!
! Mirror the d* routines with f32x4 SIMD (4 lanes per 128-bit) instead of
! f64x2 (2 lanes). Each scalar/vector type is f32 instead of f64; byte
! offsets use 4 instead of 8. Per-cycle throughput is approximately 2x
! higher than the f64 versions on the same hardware.
!
! Implemented subset: saxpy, sdot, snrm2, scopy, sscal, sgemv, sger,
! sgemm, sgetrf, sgetrs, sgesv. Other f32 BLAS/LAPACK routines (spotrf,
! spotrs, etc.) can be added as needed; the porting is mechanical.
! ══════════════════════════════════════════════════════════════════════

! ── ALAS Level 1 (f32) ────────────────────────────────────────────────

subroutine alas.sscal(x: array f32; n: i32; alpha: f32)
var
  i, n4: i32
  va, vx: f32x4
begin
  va := f32x4.splat(alpha)
  n4 := n / 4
  for i := 0, n4
    vx := v128.load(x, i)
    vx := va * vx
    call v128.store(x, i, vx)
  end for
  for i := n4 * 4, n
    x[i] := alpha * x[i]
  end for
end

subroutine alas.scopy(x: array f32; y: array f32; n: i32)
var
  i, n4: i32
  vx: f32x4
begin
  n4 := n / 4
  for i := 0, n4
    vx := v128.load(x, i)
    call v128.store(y, i, vx)
  end for
  for i := n4 * 4, n
    y[i] := x[i]
  end for
end

subroutine alas.saxpy(x: array f32; y: array f32; n: i32; alpha: f32)
var
  i, n4: i32
  va, vx, vy: f32x4
begin
  va := f32x4.splat(alpha)
  n4 := n / 4
  for i := 0, n4
    vx := v128.load(x, i)
    vy := v128.load(y, i)
    vy := f32x4.relaxed_madd(va, vx, vy)
    call v128.store(y, i, vy)
  end for
  for i := n4 * 4, n
    y[i] := alpha * x[i] + y[i]
  end for
end

function alas.sdot(x: array f32; y: array f32; n: i32): f32
var
  i, n4: i32
  vx, vy, vs: f32x4
begin
  vs := f32x4.splat(0.0)
  n4 := n / 4
  for i := 0, n4
    vx := v128.load(x, i)
    vy := v128.load(y, i)
    vs := vs + vx * vy
  end for
  alas.sdot := f32x4.extract_lane(vs, 0) + f32x4.extract_lane(vs, 1) + f32x4.extract_lane(vs, 2) + f32x4.extract_lane(vs, 3)
  for i := n4 * 4, n
    alas.sdot := alas.sdot + x[i] * y[i]
  end for
end

function alas.snrm2(x: array f32; n: i32): f32
var
  i, n4: i32
  vx, vs: f32x4
begin
  vs := f32x4.splat(0.0)
  n4 := n / 4
  for i := 0, n4
    vx := v128.load(x, i)
    vs := vs + vx * vx
  end for
  alas.snrm2 := f32x4.extract_lane(vs, 0) + f32x4.extract_lane(vs, 1) + f32x4.extract_lane(vs, 2) + f32x4.extract_lane(vs, 3)
  for i := n4 * 4, n
    alas.snrm2 := alas.snrm2 + x[i] * x[i]
  end for
  alas.snrm2 := sqrt(alas.snrm2)
end

! ── ALAS Level 2 (f32) ────────────────────────────────────────────────

subroutine alas.sgemv(
  a: array f32; x: array f32; y: array f32;
  m, n: i32; alpha, beta: f32
)
var
  i, j, n4, a_row, joff: i32
  s: f32
  vs, va, vx: f32x4
begin
  n4 := n / 4
  for i := 0, m
    vs := f32x4.splat(0.0)
    a_row := i * n * 4
    for j := 0, n4
      joff := j * 16
      va := v128.load_at(a, a_row + joff)
      vx := v128.load(x, j)
      vs := vs + va * vx
    end for
    s := f32x4.extract_lane(vs, 0) + f32x4.extract_lane(vs, 1) + f32x4.extract_lane(vs, 2) + f32x4.extract_lane(vs, 3)
    for j := n4 * 4, n
      s := s + a[i, n, j] * x[j]
    end for
    y[i] := alpha * s + beta * y[i]
  end for
end

subroutine alas.sger(
  a: array f32; x: array f32; y: array f32;
  m, n: i32; alpha: f32
)
var
  i, j, n4, a_row, joff: i32
  t: f32
  tv, vy, va: f32x4
begin
  n4 := n / 4
  for i := 0, m
    t := alpha * x[i]
    tv := f32x4.splat(t)
    a_row := i * n * 4
    for j := 0, n4
      joff := j * 16
      vy := v128.load(y, j)
      va := v128.load_at(a, a_row + joff)
      va := f32x4.relaxed_madd(tv, vy, va)
      call v128.store_at(a, a_row + joff, va)
    end for
    for j := n4 * 4, n
      a[i, n, j] := a[i, n, j] + t * y[j]
    end for
  end for
end

! ── ALAS Level 3 (f32) ────────────────────────────────────────────────

subroutine alas.sgemm(
  a: array f32; b: array f32; c: array f32;
  m, n, k: i32; alpha, beta: f32
)
var
  i, j, p, n4, c_row, b_row, joff: i32
  t: f32
  tv, vb, vc: f32x4
begin
  if (beta == 0.0) then
    for i := 0, m
      for j := 0, n
        c[i, n, j] := 0.0
      end for
    end for
  else if (beta /= 1.0) then
    for i := 0, m
      for j := 0, n
        c[i, n, j] := beta * c[i, n, j]
      end for
    end for
  end if

  n4 := n / 4
  for i := 0, m
    c_row := i * n * 4
    for p := 0, k
      t := alpha * a[i, k, p]
      tv := f32x4.splat(t)
      b_row := p * n * 4
      for j := 0, n4
        joff := j * 16
        vb := v128.load_at(b, b_row + joff)
        vc := v128.load_at(c, c_row + joff)
        vc := f32x4.relaxed_madd(tv, vb, vc)
        call v128.store_at(c, c_row + joff, vc)
      end for
      for j := n4 * 4, n
        c[i, n, j] := c[i, n, j] + t * b[p, n, j]
      end for
    end for
  end for
end

! ── ALPACK (f32) ──────────────────────────────────────────────────────

subroutine alpack.sgetrf(
  a: array f32; n: i32;
  ipiv: array i32; info: array i32
)
var
  i, j, k, pivot, nrem, nrem4, ai_base, ak_base, joff: i32
  t, inv, m, v: f32
  mv, vk, vi: f32x4
begin
  info[0] := 0
  for k := 0, n
    pivot := k
    v := a[k, n, k]
    t := abs(v)
    for i := k + 1, n
      v := a[i, n, k]
      v := abs(v)
      if (v > t) then
        pivot := i
        t := v
      end if
    end for
    ipiv[k] := pivot

    if (pivot /= k) then
      for j := 0, n
        t := a[k, n, j]
        a[k, n, j] := a[pivot, n, j]
        a[pivot, n, j] := t
      end for
    end if

    if (a[k, n, k] == 0.0) then
      info[0] := k + 1
      call return()
    end if

    inv := 1.0 / a[k, n, k]
    nrem := n - k - 1
    nrem4 := nrem / 4
    ak_base := (k * n + k + 1) * 4
    for i := k + 1, n
      m := a[i, n, k] * inv
      a[i, n, k] := m
      mv := f32x4.splat(m)
      ai_base := (i * n + k + 1) * 4
      for j := 0, nrem4
        joff := j * 16
        vk := v128.load_at(a, ak_base + joff)
        vi := v128.load_at(a, ai_base + joff)
        vi := f32x4.relaxed_nmadd(mv, vk, vi)
        call v128.store_at(a, ai_base + joff, vi)
      end for
      for j := k + 1 + nrem4 * 4, n
        a[i, n, j] := a[i, n, j] - m * a[k, n, j]
      end for
    end for
  end for
end

subroutine alpack.sgetrs(
  lu: array f32; ipiv: array i32;
  b: array f32; n, nrhs: i32
)
var
  rhs, i, j, p, j4, lu_row, joff: i32
  s, t: f32
  acc, vlu, vb: f32x4
begin
  for rhs := 0, nrhs
    for i := 0, n
      p := ipiv[i]
      if (p /= i) then
        t := b[i, nrhs, rhs]
        b[i, nrhs, rhs] := b[p, nrhs, rhs]
        b[p, nrhs, rhs] := t
      end if
    end for

    if (nrhs == 1) then
      for i := 1, n
        s := b[i]
        j4 := i / 4
        acc := f32x4.splat(0.0)
        lu_row := i * n * 4
        for j := 0, j4
          joff := j * 16
          vlu := v128.load_at(lu, lu_row + joff)
          vb := v128.load(b, j)
          acc := acc + vlu * vb
        end for
        s := s - f32x4.extract_lane(acc, 0) - f32x4.extract_lane(acc, 1) - f32x4.extract_lane(acc, 2) - f32x4.extract_lane(acc, 3)
        for j := j4 * 4, i
          s := s - lu[i, n, j] * b[j]
        end for
        b[i] := s
      end for
      for i := n - 1, -1, -1
        s := b[i]
        j4 := (n - i - 1) / 4
        acc := f32x4.splat(0.0)
        lu_row := (i * n + i + 1) * 4
        for j := 0, j4
          joff := j * 16
          vlu := v128.load_at(lu, lu_row + joff)
          vb := v128.load_at(b, (i + 1) * 4 + joff)
          acc := acc + vlu * vb
        end for
        s := s - f32x4.extract_lane(acc, 0) - f32x4.extract_lane(acc, 1) - f32x4.extract_lane(acc, 2) - f32x4.extract_lane(acc, 3)
        for j := i + 1 + j4 * 4, n
          s := s - lu[i, n, j] * b[j]
        end for
        b[i] := s / lu[i, n, i]
      end for
    else
      for i := 1, n
        s := b[i, nrhs, rhs]
        for j := 0, i
          s := s - lu[i, n, j] * b[j, nrhs, rhs]
        end for
        b[i, nrhs, rhs] := s
      end for
      for i := n - 1, -1, -1
        s := b[i, nrhs, rhs]
        for j := i + 1, n
          s := s - lu[i, n, j] * b[j, nrhs, rhs]
        end for
        b[i, nrhs, rhs] := s / lu[i, n, i]
      end for
    end if
  end for
end

subroutine alpack.sgesv(
  a: array f32; b: array f32;
  n, nrhs: i32;
  ipiv: array i32; info: array i32
)
begin
  call alpack.sgetrf(a, n, ipiv, info)
  if (info[0] /= 0) then
    call return()
  end if
  call alpack.sgetrs(a, ipiv, b, n, nrhs)
end
