! @gcu/wasm4 rasterizer — draws into the shared WASM-4 framebuffer (0xA0, 2bpp,
! 40 bytes/row). DRAW_COLORS @ 0x14: nibble0 = fill, nibble1 = outline; a nibble
! value of 0 = transparent, 1..4 → framebuffer palette index 0..3 (nibble - 1).

subroutine setpx(x, y, ci: i32)
var addr, shift, b, mask: i32
begin
  if (x < 0) then call return() end if
  if (x > 159) then call return() end if
  if (y < 0) then call return() end if
  if (y > 159) then call return() end if
  addr := 160 + y * 40 + (x >> 2)
  shift := (x & 3) * 2
  b := wasm.load8_u(addr)
  mask := 3 << shift
  b := (b & (~mask)) | ((ci & 3) << shift)
  call wasm.store8(addr, b)
end

subroutine hline(x, y, len: i32)
var dc, c, i: i32
begin
  dc := wasm.load16_u(20)
  c := dc & 15
  if (c == 0) then call return() end if
  for i := x, x + len
    call setpx(i, y, c - 1)
  end for
end

subroutine vline(x, y, len: i32)
var dc, c, i: i32
begin
  dc := wasm.load16_u(20)
  c := dc & 15
  if (c == 0) then call return() end if
  for i := y, y + len
    call setpx(x, i, c - 1)
  end for
end

subroutine rect(x, y, w, h: i32)
var dc, fillc, linec, px, py: i32
begin
  dc := wasm.load16_u(20)
  fillc := dc & 15
  linec := (dc >> 4) & 15
  if (fillc /= 0) then
    for py := y, y + h
      for px := x, x + w
        call setpx(px, py, fillc - 1)
      end for
    end for
  end if
  if (linec /= 0) then
    for px := x, x + w
      call setpx(px, y, linec - 1)
      call setpx(px, y + h - 1, linec - 1)
    end for
    for py := y, y + h
      call setpx(x, py, linec - 1)
      call setpx(x + w - 1, py, linec - 1)
    end for
  end if
end

subroutine line(x1, y1, x2, y2: i32)
var dc, c, dx, dy, sx, sy, err, e2, x, y: i32
begin
  dc := wasm.load16_u(20)
  c := dc & 15
  if (c == 0) then call return() end if
  x := x1
  y := y1
  dx := x2 - x1
  if (dx < 0) then dx := 0 - dx end if
  dy := y2 - y1
  if (dy < 0) then dy := 0 - dy end if
  if (x1 < x2) then sx := 1 else sx := 0 - 1 end if
  if (y1 < y2) then sy := 1 else sy := 0 - 1 end if
  err := dx - dy
  while (1)
    call setpx(x, y, c - 1)
    if (x == x2) then
      if (y == y2) then break end if
    end if
    e2 := 2 * err
    if (e2 > (0 - dy)) then
      err := err - dy
      x := x + sx
    end if
    if (e2 < dx) then
      err := err + dx
      y := y + sy
    end if
  end while
end

! Fill oval inscribed in (x,y,w,h). v1: solid fill (fillc, else outline color);
! integer point-in-ellipse test. Outline-only ovals are a TODO.
subroutine oval(x, y, w, h: i32)
var dc, fillc, c, cx, cy, rx, ry, px, py, ddx, ddy, lhs, rhs: i32
begin
  dc := wasm.load16_u(20)
  fillc := dc & 15
  c := fillc
  if (c == 0) then c := (dc >> 4) & 15 end if
  if (c == 0) then call return() end if
  rx := w / 2
  ry := h / 2
  cx := x + rx
  cy := y + ry
  rhs := rx * rx * ry * ry
  for py := y, y + h
    for px := x, x + w
      ddx := px - cx
      ddy := py - cy
      lhs := ddx * ddx * ry * ry + ddy * ddy * rx * rx
      if (lhs <= rhs) then
        call setpx(px, py, c - 1)
      end if
    end for
  end for
end

! Read one bpp-bit sprite pixel value at linear pixel index `idx` (sprites are
! packed MSB-first, no per-row padding — blitSub supplies the stride).
function blit_px(sprite, idx, bpp: i32): i32
var bit, b, shift: i32
begin
  bit := idx * bpp
  b := wasm.load8_u(sprite + (bit >> 3))
  shift := bit & 7
  if (bpp == 1) then
    blit_px := (b >> (7 - shift)) & 1
  else
    blit_px := (b >> (6 - shift)) & 3
  end if
end

! blitSub: draw a w×h region of a sprite sheet (rooted at srcX,srcY, sheet width
! = stride px) at (x,y). flags: bit0 BLIT_2BPP, bit1 FLIP_X, bit2 FLIP_Y,
! bit3 ROTATE (v1: transpose — true 90° corner cases are a TODO). Each source
! value selects a DRAW_COLORS nibble; nibble 0 = transparent.
subroutine blitSub(sprite, x, y, w, h, srcX, srcY, stride, flags: i32)
var bpp, flipx, flipy, rot, dcbits, sy, sx, sval, dc, tx, ty, tmp: i32
begin
  bpp := (flags & 1) + 1
  flipx := flags & 2
  flipy := flags & 4
  rot := flags & 8
  dcbits := wasm.load16_u(20)
  for sy := 0, h
    for sx := 0, w
      sval := blit_px(sprite, (srcY + sy) * stride + (srcX + sx), bpp)
      dc := (dcbits >> (sval * 4)) & 15
      if (dc /= 0) then
        tx := sx
        ty := sy
        if (flipx /= 0) then tx := w - 1 - tx end if
        if (flipy /= 0) then ty := h - 1 - ty end if
        if (rot /= 0) then
          tmp := tx
          tx := ty
          ty := tmp
        end if
        call setpx(x + tx, y + ty, dc - 1)
      end if
    end for
  end for
end

! blit: whole sprite (blitSub with src 0,0 and stride = w).
subroutine blit(sprite, x, y, w, h, flags: i32)
begin
  call blitSub(sprite, x, y, w, h, 0, 0, w, flags)
end

! text: draw a NUL-terminated string at (x,y) using the WASM-4 system font the
! host wrote at FONT_BASE (0xDC00). Faithful to the real runtime: each glyph is
! a 1bpp 8×8 sprite at row (c-0x20)*8 of the font sheet, blitted with the same
! path sprites use (on-pixel = 0 bit → DRAW_COLORS nibble 0; off = nibble 1;
! nibble 0 transparent). \n wraps. The font has real glyphs for 0x20-0xFF.
subroutine text(strPtr, x, y: i32)
var col, cy, ci, c: i32
begin
  col := 0
  cy := y
  ci := 0
  while (1)
    c := wasm.load8_u(strPtr + ci)
    if (c == 0) then break end if
    if (c == 10) then
      col := 0
      cy := cy + 8
    else
      if (c >= 32) then
        call blitSub(56320, x + col * 8, cy, 8, 8, 0, (c - 32) * 8, 8, 0)
      end if
      col := col + 1
    end if
    ci := ci + 1
  end while
end
