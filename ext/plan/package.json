{
  "name": "@gcu/plan",
  "version": "0.1.0",
  "description": "Project scheduling and analysis: CPM, PERT, Monte Carlo, EVM, S-curves, resource leveling, sensitivity. Working calendars with holidays (pt-BR built-in). SVG Gantt and analysis rendering.",
