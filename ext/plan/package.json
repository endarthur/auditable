  "main": "src/main.js",
  "exports": {
    ".": "./src/main.js",
    "./calendar": "./src/calendar.js",
    "./pert": "./src/pert.js",
    "./graph": "./src/graph.js",
    "./schedule": "./src/schedule.js",
    "./resource": "./src/resource.js",
    "./scurve": "./src/scurve.js",
    "./evm": "./src/evm.js",
    "./analysis": "./src/analysis.js",
    "./workflow": "./src/workflow.js",
    "./montecarlo": "./src/montecarlo.js",
    "./render": "./src/render.js",
    "./xlsx": "./src/xlsx.js",
    "./holidays-br": "./src/holidays-br.js",
    "./bundled": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.js",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js"
  },
